<?xml version="1.0" encoding="utf-8"?>
<!-- Fifth page: internet radio. Left: what is playing, with big controls.
     Right: presets and categories as a grid of large station tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="14dp"
    android:visibility="invisible">

    <!-- Now playing -->
    <LinearLayout
        android:id="@+id/radioCard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:layout_weight="38"
        android:background="@drawable/tile_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/radioState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_dim" />

            <TextView
                android:id="@+id/radioStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/radio_preset"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:text="☆"
                android:textColor="@color/accent" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/radioArtBox"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/art_bg">

            <TextView
                android:id="@+id/radioLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:textColor="@color/text" />

            <ImageView
                android:id="@+id/radioArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/radioName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/radioTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="2"
            android:textColor="@color/text_dim" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Previous, play/pause, next: always left to right, as on any player -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/radioPrev"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/np_previous"
                android:scaleType="centerInside"
                android:src="@drawable/ic_np_prev" />

            <ImageView
                android:id="@+id/radioPlay"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/round_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/np_play_pause"
                android:scaleType="centerInside"
                android:src="@drawable/ic_np_play" />

            <ImageView
                android:id="@+id/radioNext"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/np_next"
                android:scaleType="centerInside"
                android:src="@drawable/ic_np_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stations -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="62"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/radioTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/radioTab0" style="@style/RadioChip" android:text="@string/radio_tab_presets" />
                <TextView android:id="@+id/radioTab1" style="@style/RadioChip" android:text="@string/radio_tab_saudi" />
                <TextView android:id="@+id/radioTab2" style="@style/RadioChip" android:text="@string/radio_tab_quran" />
                <TextView android:id="@+id/radioTab3" style="@style/RadioChip" android:text="@string/radio_tab_news" />
                <TextView android:id="@+id/radioTab4" style="@style/RadioChip" android:text="@string/radio_tab_music" />
                <TextView android:id="@+id/radioTab5" style="@style/RadioChip" android:text="@string/radio_tab_search" />
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/radioSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/tile_bg"
            android:hint="@string/radio_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/idle"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/radioGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:clipToPadding="false"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbarStyle="outsideOverlay"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />

            <TextView
                android:id="@+id/radioEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/text_dim"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
