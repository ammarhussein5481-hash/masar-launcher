<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9+ blocks plain http:// by default. Two things here only speak it: the 70mai dash
     cam on its own Wi-Fi, and a large share of internet radio streams and station logos. So
     plain HTTP is allowed. Masar sends nothing private over it: only stream and image requests. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
